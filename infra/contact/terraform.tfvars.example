aws_region     = "ap-northeast-1"
project_name   = "jun01t-portfolio"
to_email       = "you@example.com"
from_email     = "you@example.com"
budget_alert_email = "you@example.com"
site_subdomain = "jun01t-portfolio.jun01t.com"
route53_zone_name = "jun01t.com"
allowed_origins = [
  "https://jun01t-portfolio.jun01t.com",
]

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Hostnames に jun01t-portfolio.jun01t.com と localhost を追加
turnstile_site_key   = "0x4AAAA..."
turnstile_secret_key = "0x4AAAA..."

# Cost guards (optional overrides)
# api_throttle_rate_limit      = 5
# api_throttle_burst_limit     = 10
# lambda_reserved_concurrency  = 5
# monthly_budget_usd           = 5
